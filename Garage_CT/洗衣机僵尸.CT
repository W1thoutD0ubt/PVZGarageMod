mov ecx,[ebx]
add [eax+1C],ecx //所在行
call cjxg
mov ecx,[ebx+4]
add [eax+1C],ecx //所在行
pop ebx
ret
sjpy1:
dd #0 #1
sjpy2:
dd #-1 #0
sjpy3:
dd #-1 #1

