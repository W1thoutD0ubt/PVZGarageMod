    <CheatEntry>
      <ID>1544</ID>
      <Description>"杨桃索敌修正"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(newmem,2048)

newmem:
//eax 僵尸指针
//esi 植物指针
//45EF38 攻击
//originalcode 停止
test eax,eax
jne 45EF38
cmp [esi+24],#29 //植物ID
jne originalcode
pushad
mov ebx,[esi+4]
mov eax,[ebx+94] //最多时僵尸数
mov ebx,[ebx+90] //目标僵尸指针
mov ecx,[esi+8] //X
lea ecx,[ecx-50]
lea edx,[ecx+B4]
while:
cmp byte [ebx+EC],#0 //判断僵尸是否存在
jne next
cmp byte [ebx+BA],#0 //判断僵尸是否濒死
je next
cmp byte [ebx+B8],#0 //判断僵尸是否魅惑
jne next
cmp [ebx+8],ecx //X
jl next
cmp [ebx+8],edx //X
jg next
jmp end
next:
add ebx,ZombieClassSize
test eax,eax
dec eax
jg while
popad
originalcode:
xor al,al
pop edi
jmp returnhere
end:
popad
jmp 45EF38

