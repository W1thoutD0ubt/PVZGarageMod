/*Board::DealWithProjectile
(int* theParameterArray2,void Function()
int* theParameterArray1,bool Function(),
eax = Board* this)*/
Board::DealWithProjectile:
push ebp
mov ebp,esp
push edi
mov edi,eax//Board
push esi
push ebx


xor esi,esi
push esi
Lxh:
mov esi,esp
mov edx,edi
call 41C9B0  //遍历函数
test al,al
je short Lxhe
push esi
mov esi,[esi]  //esi=遍历对象的基址
//此处为遍历代码

//jmp short g0

//条件函数
mov eax,[ebp+8]
test eax,eax
je short core//无条件
mov ebx,[ebp+c]//参数数组
mov eax,[ebx]//数组大小
IfParameterEnd:
cmp al,0//不含自身
jng short ParameterEnd
add ebx,4
push [ebx]
dec al
jmp short IfParameterEnd

ParameterEnd:
call [ebp+8]//条件判断函数,esi=子弹


test eax,eax
je short g0


core:
//处理函数
mov eax,[ebp+10]
test eax,eax
je short g0//无处理
mov ebx,[ebp+14]//参数数组
mov eax,[ebx]//数组大小
IfParameterEnd1:
cmp al,0//不含自身
jng short ParameterEnd1
add ebx,4
push [ebx]
dec al
jmp short IfParameterEnd1

ParameterEnd1:
