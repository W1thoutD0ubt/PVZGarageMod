<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>2138</ID>
      <Description>"加载DLL"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
globalalloc(loaddll, 256)
createthread(loaddll)

loaddll:
    push DLL_Name
    call dword ptr [006520A4]
    test eax,eax
    jnz myexit
    call dword ptr [006520B4]
    mov [DLL_LastError],eax
    push 10
    push 006586EC // "Error"
    push DLL_NotFound
    push 0
    call dword ptr [006523CC]
    or eax,-01
    push eax
    call 61DD92
myexit:
    push DLL_InitMethod
    push eax
    call dword ptr [006520AC]
    call eax
    ret

DLL_Name:
    db 'garage.dll' 0
DLL_NotFound:
    db 'Could NOT find garage.dll' 0
DLL_InitMethod:
    db 'init' 0
DLL_LastError:
    dd 0 0

[DISABLE]

</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>2140</ID>
      <Description>"种植物前种花盆"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(newmem,2048)

newmem:
    pushfd
    push eax

    mov al,[ecx+55EA]
    test al,al

    pop eax
    jz originalcode
    popfd
    
    cmp byte ptr [esp+17],00
    jmp 40e2d0

originalcode:
    popfd
    je 0040E2E3
    cmp byte ptr [esp+17],00

0040E2CB:
    jmp newmem
    nop 2
returnhere:
 
 
[DISABLE]
dealloc(newmem)
    0040E2CB:
    db 74 16 80 7C 24 17 00

</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>1</ID>
      <Description>"PixelToGridY"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(newmem,2048)
newmem:
    cmp byte [esi+55EA],0
    je originalcode
    cmp eax,#320
    jnl originalcode

{$CCODE result=EAX y=EDI}
    int x = result;

    int delimiter[4][5] = {
        {150, 245, 360, 440, 580},
        {165, 245, 360, 460, 580},
        {180, 245, 360, 480, 580},
        {180, 265, 370, 480, 580}
    };

    x = (x - 40) / 80;
    if (x &lt; 0)
        result = 0;
    else
    {
        result = 0;
        for (;result &lt; 5; result++)
            if (y &lt; delimiter[x][result])
                break;
    }
{$ASM}
    jmp 41C645

originalcode:
    mov ecx,[esi+0000008C]
    jmp returnhere
align 10,CC

41C556:
    jmp newmem
    nop
returnhere:

[DISABLE]
dealloc(newmem)
41C556:
    mov ecx,[esi+0000008C]
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>2137</ID>
      <Description>"GridToPixelY"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(newmem,2048)
newmem:
    cmp byte [ebx+55EA],0
    je oricode
    cmp ecx,4
    jnl oricode
    cmp eax,0
    jl oricode
    cmp eax,5
    jg oricode

{$CCODE result=EAX col=ECX}
    int row = result;

    int delimiter[4][6] = {
        {80, 150, 245, 340, 480, 580},
        {80, 180, 245, 380, 480, 580},
        {80, 180, 245, 380, 480, 580},
        {80, 180, 280, 380, 480, 580}
    };

    result = delimiter[col][row];
{$ASM}
    jmp 41C777

oricode:
    mov eax,[ebx+0000008C]
    jmp returnhere
align 10,CC

41C744:
    jmp newmem
    nop
returnhere:

[DISABLE]
dealloc(newmem)
41C744:
    mov eax,[ebx+0000008C]
</AssemblerScript>
